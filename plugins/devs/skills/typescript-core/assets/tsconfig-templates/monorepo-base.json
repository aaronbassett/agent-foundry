{
  // Monorepo root base: packages extend this and add their own include,
  // rootDir, outDir, and (for cross-package imports) project references plus
  // the workspace protocol in package.json. No baseUrl/paths mapping —
  // workspace linking belongs to the package manager.
  // Packages need "type": "module" in their package.json (see strict-node.json).
  "extends": "./strict-base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true
  }
}
