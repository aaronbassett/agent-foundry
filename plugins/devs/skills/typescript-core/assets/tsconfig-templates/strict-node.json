{
  // Node service/application. Requires "type": "module" in package.json —
  // under nodenext, .ts files are otherwise treated as CommonJS and
  // verbatimModuleSyntax then rejects ESM syntax (TS1287). "types" must name
  // ["node"] explicitly (nothing is auto-included) and rootDir must be set
  // when emitting (it defaults to the tsconfig's directory).
  "extends": "./strict-base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],

    // Allows running sources directly via Node's native type stripping
    // (rules out enums, namespaces, and constructor parameter properties):
    "erasableSyntaxOnly": true,

    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*"]
}
