{
  // React application (bundler does the emitting; tsc only type-checks).
  // Plain "dom" includes the iterable DOM APIs; "paths" needs no baseUrl.
  "extends": "./strict-base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "jsx": "react-jsx",
    "noEmit": true,

    // Add your bundler's client types here, e.g. "types": ["vite/client"]
    "types": [],

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
