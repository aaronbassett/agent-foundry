{
  // Published library. Requires "type": "module" in package.json (see
  // strict-node.json). nodenext resolution on purpose: "bundler" would let you
  // author import specifiers that break for consumers resolving under node.
  "extends": "./strict-base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],

    "declaration": true,
    "declarationMap": true,
    // Fast, tool-independent .d.ts emit; requires explicit types on exports.
    // Delete if that constraint fights your API surface.
    "isolatedDeclarations": true,

    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts"]
}
